# Root copy for local convenience. Prefer apps/*/.env.example when configuring deploys.
# Never commit real secrets. BOT_TOKEN / JWT secrets live only in Railway / Vercel / local .env (gitignored).

# --- Shared / local ---
NODE_ENV=development

# --- Frontend (Vercel / apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_BOT_USERNAME=CoinBarnBot

# --- Backend (Railway / apps/api) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coinbarn
BOT_TOKEN=
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
INITDATA_MAX_AGE_SEC=86400
CORS_ORIGIN=http://localhost:3000
PORT=3001
REF_SHARE_PERCENT=5
REF_INVITE_BONUS=500
REF_WELCOME_BONUS=200
TELEGRAM_CHANNEL_ID=
