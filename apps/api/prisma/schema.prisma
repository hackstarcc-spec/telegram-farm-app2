generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoostKind {
  farm_speed
  storage_cap
  energy_per_tap
  energy_max
}

enum TaskKind {
  daily
  channel_subscribe
  invite_friends
  one_time
}

enum TaskStatus {
  available
  completed
  claimed
}

enum ReferralEarningSource {
  farm_claim
  tap
  other
}

model User {
  id                  String    @id @default(cuid())
  telegramUserId      BigInt    @unique @map("telegram_user_id")
  username            String?
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  languageCode        String?   @map("language_code")
  photoUrl            String?   @map("photo_url")
  coins               BigInt    @default(0)
  totalEarned         BigInt    @default(0) @map("total_earned")
  energy              Int       @default(100)
  energyMax           Int       @default(100) @map("energy_max")
  energyUpdatedAt     DateTime  @default(now()) @map("energy_updated_at")
  farmRatePerHour     Int       @default(100) @map("farm_rate_per_hour")
  storageCap          BigInt    @default(5000) @map("storage_cap")
  storageAccumulated  BigInt    @default(0) @map("storage_accumulated")
  farmUpdatedAt       DateTime  @default(now()) @map("farm_updated_at")
  tapEnergyCost       Int       @default(1) @map("tap_energy_cost")
  coinsPerTap         Int       @default(1) @map("coins_per_tap")
  referredByUserId    String?   @map("referred_by_user_id")
  referralCode        String    @unique @map("referral_code")
  dailyStreak         Int       @default(0) @map("daily_streak")
  lastDailyClaimAt    DateTime? @map("last_daily_claim_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  referredBy          User?     @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals           User[]    @relation("UserReferrals")
  sessions            Session[]
  userBoosts          UserBoost[]
  userTasks           UserTask[]
  invitesSent         Referral[] @relation("InviterReferrals")
  inviteRecord        Referral?  @relation("InviteeReferral")
  referralEarningsAsInviter ReferralEarning[] @relation("InviterEarnings")
  referralEarningsAsInvitee ReferralEarning[] @relation("InviteeEarnings")
  dailyRewardClaims   DailyRewardClaim[]

  @@index([totalEarned(sort: Desc)])
  @@index([referredByUserId])
  @@map("users")
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Boost {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           BoostKind
  name           String
  description    String?
  maxLevel       Int       @map("max_level")
  basePrice      BigInt    @map("base_price")
  priceGrowth    Float     @map("price_growth")
  effectPerLevel Float     @map("effect_per_level")
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  userBoosts UserBoost[]

  @@index([kind, sortOrder])
  @@map("boosts")
}

model UserBoost {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  boostId     String   @map("boost_id")
  level       Int      @default(0)
  purchasedAt DateTime @default(now()) @map("purchased_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  boost Boost @relation(fields: [boostId], references: [id], onDelete: Cascade)

  @@unique([userId, boostId])
  @@index([boostId])
  @@map("user_boosts")
}

model Task {
  id          String   @id @default(cuid())
  code        String   @unique
  kind        TaskKind
  title       String
  description String?
  rewardCoins BigInt   @map("reward_coins")
  payload     Json?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  userTasks UserTask[]

  @@index([kind, isActive])
  @@map("tasks")
}

model UserTask {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  taskId      String     @map("task_id")
  status      TaskStatus @default(available)
  progress    Int        @default(0)
  completedAt DateTime?  @map("completed_at")
  claimedAt   DateTime?  @map("claimed_at")
  periodKey   String?    @map("period_key")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, periodKey])
  @@index([userId, status])
  @@map("user_tasks")
}

model Referral {
  id         String   @id @default(cuid())
  inviterId  String   @map("inviter_id")
  inviteeId  String   @unique @map("invitee_id")
  bonusPaid  Boolean  @default(false) @map("bonus_paid")
  createdAt  DateTime @default(now()) @map("created_at")

  inviter User @relation("InviterReferrals", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InviteeReferral", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@map("referrals")
}

model ReferralEarning {
  id          String                 @id @default(cuid())
  inviterId   String                 @map("inviter_id")
  inviteeId   String                 @map("invitee_id")
  source      ReferralEarningSource
  baseAmount  BigInt                 @map("base_amount")
  shareAmount BigInt                 @map("share_amount")
  createdAt   DateTime               @default(now()) @map("created_at")

  inviter User @relation("InviterEarnings", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InviteeEarnings", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
  @@index([inviteeId, createdAt])
  @@map("referral_earnings")
}

model DailyRewardTier {
  dayIndex    Int     @id @map("day_index")
  rewardCoins BigInt  @map("reward_coins")
  label       String?

  @@map("daily_reward_tiers")
}

model DailyRewardClaim {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dayIndex    Int      @map("day_index")
  rewardCoins BigInt   @map("reward_coins")
  claimDate   DateTime @db.Date @map("claim_date")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimDate])
  @@map("daily_reward_claims")
}
