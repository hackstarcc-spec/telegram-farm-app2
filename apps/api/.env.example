# Railway (API + PostgreSQL). Do NOT commit real values.
# BOT_TOKEN / JWT secrets must be set in Railway Variables — never in git.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coinbarn

# Telegram bot token (HMAC initData + getChatMember). Set in Railway only.
BOT_TOKEN=

# Prefer JWT_ACCESS_SECRET / JWT_REFRESH_SECRET; JWT_SECRET is a single-secret fallback.
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Max age of Telegram initData auth_date (seconds). Default 24h.
INITDATA_MAX_AGE_SEC=86400

# CORS allowlist: ONLY the Vercel Mini App origin (no *).
CORS_ORIGIN=http://localhost:3000

# Referral economy (defaults from plan prefs)
REF_SHARE_PERCENT=5
REF_INVITE_BONUS=500
REF_WELCOME_BONUS=200

# Optional: channel task verification
TELEGRAM_CHANNEL_ID=
